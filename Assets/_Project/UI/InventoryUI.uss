.inventory-panel {
    width: 380px;
    padding: 20px;
    margin-left: 32px;
    margin-top: 32px;
    background-color: rgba(20, 24, 30, 0.824);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
}

.inventory-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(245, 247, 250);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    -unity-text-align: upper-center;
}

.inventory-container {
    flex-grow: 1;
}

.inventory-slot {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.471);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.inventory-slot:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.22);
}

.slot-icon {
    width: 60px;
    height: 60px;
    margin-right: 14px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    -unity-background-scale-mode: scale-to-fit;
    background-size: 70% 70%;
    background-position: center;
}

.slot-text-container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.item-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 240, 245);
    padding: 0;
    margin: 0;
}

.item-amount {
    font-size: 15px;
    color: rgb(190, 205, 220);
    background-color: rgba(0, 0, 0, 0.4);
    padding: 4px 8px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    margin: 0;
}

.inventory-footer {
    font-size: 16px;
    color: rgba(210, 220, 230, 0.55);
    -unity-text-align: middle-center;
    margin-top: 14px;
    padding-top: 8px;
}
